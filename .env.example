# Copy to .env and fill in the required Keycloak values before running Compose.
# See docs/development/local-setup.md for setup instructions.

# PostgreSQL (local development defaults)
POSTGRES_DB=waypoint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5433

# Keycloak bootstrap administrator and host port
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=secret
KEYCLOAK_PORT=8081

# Required: generate a secret and share it with the frontend server's auth config.
# See docs/frontend/auth.md for frontend and social-login configuration.
KEYCLOAK_FE_CLIENT_SECRET=

# Required: credentials from your Google and GitHub OAuth applications.
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=
KEYCLOAK_GITHUB_CLIENT_ID=
KEYCLOAK_GITHUB_CLIENT_SECRET=

# Optional pgAdmin service (start with docker compose up -d pgadmin)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=secret
PGADMIN_PORT=5050

# API running on the host. The API does not load .env automatically.
# After filling in .env, export its values before starting the API:
#
# set -a
# . ./.env
# set +a
# go run ./cmd/waypoint serve --migrate
#
# Keep these URLs in sync with database credentials and host ports above.
WAYPOINT_DATABASE_URL='postgres://postgres:secret@localhost:5433/waypoint?sslmode=disable'
WAYPOINT_JWT_ISSUER=http://localhost:8081/realms/waypoint
WAYPOINT_JWT_AUDIENCE=waypoint-api
